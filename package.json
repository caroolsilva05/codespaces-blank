{
  "name": "plataforma-bellinati",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "server:dev": "node --watch server/index.js",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "check": "vite build",
    "db:import:supabase": "node scripts/import-supabase-csv-to-mysql.js",
    "preview": "vite preview",
    "preview:prod": "vite preview --host 0.0.0.0",
    "test:splunk": "powershell -ExecutionPolicy Bypass -File scripts/test-splunk-connection.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.525.0",
    "mysql2": "^3.22.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.3",
    "typescript": "^6.0.3",
    "vite": "^7.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
