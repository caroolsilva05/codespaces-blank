# API / Express
PORT=3001
API_PORT=3001
JSON_LIMIT=15mb

# MySQL - credenciais ficam apenas no backend
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=usuario
MYSQL_PASSWORD=senha
MYSQL_DATABASE=plataforma_bellinati
MYSQL_CONNECTION_LIMIT=10

# Splunk - proxy interno via backend
SPLUNK_BASE_URL=https://splunk.interno.exemplo:8089
SPLUNK_AUTH_TOKEN=token
SPLUNK_REJECT_UNAUTHORIZED=false
SPLUNK_TIMEOUT_MS=120000
